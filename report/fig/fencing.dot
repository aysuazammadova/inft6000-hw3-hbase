digraph F {
  graph [rankdir=LR, nodesep=0.15, ranksep=0.25, fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9, color="#2a5aa8", fontcolor=white, fillcolor="#3c78d8", width=1.3];
  edge [color="#555555", arrowsize=0.6, fontname="Helvetica", fontsize=8];
  subgraph cluster_min { label=<<b>minority side: rs1</b>>; fontsize=10; style="dashed,rounded"; color="#c0392b";
    m1 [label="cut off\n(still running)", fillcolor="#7f8c8d"];
    m2 [label="WAL sync fails:\nlease revoked", fillcolor="#c0392b"];
    m3 [label="heal: session\nexpired → ABORT", fillcolor="#c0392b"];
    m1 -> m2 -> m3;
  }
  subgraph cluster_maj { label=<<b>majority side: ZK quorum, HMaster, rs2, rs3</b>>; fontsize=10; style="dashed,rounded"; color="#2a5aa8";
    j1 [label="no heartbeats"];
    j2 [label="session expires\n(10 s)"];
    j3 [label="SCP: recoverLease\nsplit WAL"];
    j4 [label="regions open\non rs2/rs3"];
    j1 -> j2 -> j3 -> j4;
  }
  j3 -> m2 [style=dashed, color="#c0392b", label="fences", fontcolor="#c0392b", constraint=false];
}
